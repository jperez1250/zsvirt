# Configuración del plugin IBM FlashSystem 7300 para ZSVirt

# Dirección IP o hostname del sistema FlashSystem
flashsystem.management-ip=192.168.1.100

# Puerto REST API (por defecto 7443)
flashsystem.api-port=7443

# Usuario de servicio para automatización (NO usar Superuser)
# Crear usuario dedicado con rol Admin o Monitor según necesidades
flashsystem.username=zsvirt_admin
flashsystem.password=<password_encriptado>

# Pool de almacenamiento (mdiskgrp) donde se crearán los volúmenes
flashsystem.storage-pool=Pool_SSD

# Grupo de hosts para mapeo automático de volúmenes
flashsystem.host-group=zsvirt_cluster

# Timeout de sesión en minutos (rango válido: 10-120)
flashsystem.session-timeout=60

# Verificación SSL de certificados
# true = verificar certificados (recomendado en producción)
# false = no verificar (solo desarrollo/laboratorio)
flashsystem.verify-ssl=true

# Ruta al certificado CA del FlashSystem (opcional si verify-ssl=true)
# Si no se especifica, usa el trust store por defecto de Java
flashsystem.ca-cert-path=/etc/ssl/certs/flashsystem-ca.pem

# Habilitar Two Person Integrity (TPI) para operaciones críticas
# Requiere aprobación de dos administradores para eliminar Safeguarded Snapshots
flashsystem.enable-tpi=false

# Tipo de aprovisionamiento: thin o thick
# thin = espacio asignado bajo demanda (recomendado)
# thick = espacio reservado completamente al crear
flashsystem.provisioning-type=thin

# Habilitar Data Reduction (deduplicación + compresión)
# Requiere licencia y soporte del pool
flashsystem.enable-data-reduction=true

# Modelo Utility (Capacity on Demand)
# Solo para modelos U7D, facturación por capacidad utilizada
flashsystem.utility-model=false
